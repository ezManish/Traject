# ==============================================================================
# TRAJECT — Environment Configuration Template
# Copy this file to .env: copy .env.example .env (Windows) or cp .env.example .env (Linux/macOS)
# ==============================================================================

# NVIDIA NIM AI Inference (Optional - deterministic grounded fallback enabled if omitted)
NVIDIA_API_KEY=
NVIDIA_API_BASE=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=llama-3.3-nemotron-super-49b-v1.5
NVIDIA_EMBED_MODEL=nemotron-3-embed-1b

# Database Configuration (SQLite)
DATABASE_URL=sqlite:///./traject.db

# Live Replay Ticker Cadence
# Number of seconds each tick will take during auto-streaming (e.g. 1.0, 2.5, 3.0, 5.0)
REPLAY_TICK_SECONDS=2.5
